{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "4"
  },
  "permissions": {
    "allow": [
      "Bash(pnpm turbo run test *)",
      "Bash(pnpm turbo run typecheck *)",
      "Bash(pnpm --filter *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git worktree list*)",
      "Bash(git worktree remove *)",
      "Bash(git worktree prune*)",
      "Bash(git merge-base *)",
      "Bash(git -C * status *)",
      "Bash(git -C * log *)",
      "Bash(git -C * rev-list *)",
      "Bash(git -C * stash list*)",
      "Bash(git -C * rev-parse *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh repo create *)",
      "Bash(gh secret *)",
      "Bash(npx wrangler deploy *)",
      "Bash(npx wrangler secret *)"
    ],
    "deny": [
      "Bash(git worktree remove --force*)",
      "Bash(git worktree remove -f*)",
      "Bash(git worktree remove * --force*)",
      "Bash(git worktree remove * -f*)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(//d/TungAo-Project/line-bot/dayo-shop-system/**/.dev.vars)",
      "Read(//d/TungAo-Project/line-bot/dayo-shop-system/**/.env*)",
      "Read(//d/TungAo-Project/line-bot/dayo-shop-system/backups/**)"
    ]
  }
}
