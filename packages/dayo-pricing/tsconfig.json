{
  "extends": "../../tsconfig.base.json",
  // exactOptionalPropertyTypes off here only: src/vendor is dayo's code, byte for byte, and dayo compiles it without that
  // flag (dayo tsconfig.base.json at f4cda56). promotions.ts passes `startsOn?: string | null` into WindowDateBounds.
  "compilerOptions": { "noEmit": true, "types": ["node"], "resolveJsonModule": true, "exactOptionalPropertyTypes": false },
  "include": ["src", "test", "scripts", "golden"]
}
